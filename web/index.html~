<!DOCTYPE html>
<html lang="en">

<head>

    <meta charset="UTF-8">

    <meta name="viewport"
          content="width=device-width, initial-scale=1.0">

    <title>Notes - Powered by Musica</title>

    <style>

        body {
            margin: 0;
            font-family: Arial, Helvetica, sans-serif;
            background-color: #f4f4f4;
        }


        header {
            text-align: center;
            padding: 30px 20px;
            background-color: #d8c9a3;
            color: #3b3528;
        }


        .notes-title {
            display: flex;
            justify-content: center;
            align-items: center;
            gap: 14px;
        }


        .clef {
            font-size: 2.2em;
        }


        .note {
            font-size: 1.5em;
        }


        .script {
            font-family: cursive;
            font-size: 3em;
            font-style: italic;
        }


        .settings-bar {
            text-align: center;
            padding: 12px;
        }


        .settings-button {

            padding: 6px 14px;

            font-size: 1em;

            border: 1px solid #777;

            border-radius: 4px;

            background-color: #ffffff;

            cursor: pointer;

        }


        .settings-button:hover {

            background-color: #e8e8e8;

        }


        .modal {

            display: none;

            position: fixed;

            z-index: 1;

            left: 0;

            top: 0;

            width: 100%;

            height: 100%;

            background-color:
                rgba(0, 0, 0, 0.4);

        }


        .modal-content {

            background-color: #f4f4f4;

            margin: 10% auto;

            padding: 25px;

            border: 1px solid #777;

            border-radius: 6px;

            width: 420px;

            max-width: 85%;

        }


        .modal-header {

            display: flex;

            justify-content:
                space-between;

            align-items: center;

            margin-bottom: 20px;

        }


        .modal-header h2 {

            margin: 0;

        }


        .close {

            font-size: 1.5em;

            cursor: pointer;

        }


        .setting-row {

            margin-bottom: 16px;

        }


        .setting-label {

            font-weight: bold;

            display: block;

            margin-bottom: 4px;

        }


        .setting-value {

            padding-left: 10px;

            word-break: break-word;

        }


        .close-button {

            display: block;

            margin: 25px auto 0 auto;

            padding: 6px 20px;

            cursor: pointer;

        }

    </style>

</head>


<body>


    <header>

        <div class="notes-title">

            <span class="clef">𝄞</span>

            <span class="note">♪</span>

            <span class="script">Notes</span>

            <span class="note">♫</span>

        </div>

    </header>


    <div class="settings-bar">

        <button
            class="settings-button"
            onclick="openSettings()">

            ⚙ Settings

        </button>

    </div>


    <div
        id="settingsModal"
        class="modal">


        <div class="modal-content">


            <div class="modal-header">

                <h2>
                    Musica-Notes Settings
                </h2>

                <span
                    class="close"
                    onclick="closeSettings()">

                    &times;

                </span>

            </div>


            <div
                id="settingsContent">

                Loading settings...

            </div>


            <button
                class="close-button"
                onclick="closeSettings()">

                Close

            </button>


        </div>


    </div>


    <script>


        function openSettings() {

            const modal =
                document.getElementById(
                    "settingsModal"
                );

            const content =
                document.getElementById(
                    "settingsContent"
                );


            modal.style.display = "block";

            content.innerHTML =
                "Loading settings...";


            <!--
            fetch(
                "./py/settings.py?format=json"
            )
            -->

            fetch("/api/settings")

            .then(

                response => response.json()

            )

            .then(

                settings => {

                    displaySettings(
                        settings
                    );

                }

            )

            .catch(

                error => {

                    content.innerHTML =
                        "<b>Unable to load settings.</b>";

                    console.error(
                        error
                    );

                }

            );

        }


        function closeSettings() {

            const modal =
                document.getElementById(
                    "settingsModal"
                );

            modal.style.display = "none";

        }


        function displaySettings(settings) {

            const content =
                document.getElementById(
                    "settingsContent"
                );


            let html = "";


            html +=
                '<div class="setting-row">' +

                '<span class="setting-label">' +
                'Setup Type:' +
                '</span>' +

                '<div class="setting-value">' +

                settings.SETUP_TYPE +

                '</div>' +

                '</div>';


            html +=
                '<div class="setting-row">' +

                '<span class="setting-label">' +
                'Database:' +
                '</span>' +

                '<div class="setting-value">' +

                (
                    settings.DATABASE ||
                    "Not configured"
                ) +

                '</div>' +

                '</div>';


            if (settings.MASTER_IP) {

                html +=
                    '<div class="setting-row">' +

                    '<span class="setting-label">' +
                    'Master IP:' +
                    '</span>' +

                    '<div class="setting-value">' +

                    settings.MASTER_IP +

                    '</div>' +

                    '</div>';

            }


            if (
                settings.MASTER_USER &&
                settings.MASTER_USER.length > 0
            ) {

                html +=
                    '<div class="setting-row">' +

                    '<span class="setting-label">' +
                    'Master Users:' +
                    '</span>' +

                    '<div class="setting-value">' +

                    settings.MASTER_USER.join(
                        "<br>"
                    ) +

                    '</div>' +

                    '</div>';

            }


            if (settings.ERROR) {

                html +=
                    '<div class="setting-row">' +

                    '<span class="setting-label">' +
                    'Error:' +
                    '</span>' +

                    '<div class="setting-value">' +

                    settings.ERROR +

                    '</div>' +

                    '</div>';

            }


            content.innerHTML = html;

        }


        window.onclick =
            function(event) {

                const modal =
                    document.getElementById(
                        "settingsModal"
                    );


                if (
                    event.target == modal
                ) {

                    closeSettings();

                }

            };


    </script>


</body>

</html>
